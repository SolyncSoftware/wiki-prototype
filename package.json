{
	"name": "wiki",
	"version": "0.0.1",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"daisyui": "^5.7.50",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-figure": "^1.0.1",
		"remark-footnotes": "2.0.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"private": true,
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "bun --bun svelte-kit sync",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun --bun prettier --check . && bun --bun eslint src eslint.config.js vite.config.ts mdsvex.config.js",
		"format": "bun --bun prettier --write ."
	},
	"type": "module"
}
